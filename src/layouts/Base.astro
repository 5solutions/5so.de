---
import { person, certifications } from '../data/profile';
import photo from '../assets/stefan-sobek.jpg';
import { getImage } from 'astro:assets';
import { designs, home, designUrl } from '../data/designs';

interface Props {
  title?: string;
  description?: string;
  design?: string; // slug of the design rendering this page
  noindex?: boolean;
}
const { title = `${person.name} – ${person.role}`, description = person.description, design } = Astro.props;
// Alternative designs duplicate the homepage content: keep them out of search results and point canonical at /.
const isAlt = !!design && design !== home;
const noindex = Astro.props.noindex || isAlt;
const canonical = new URL(isAlt ? '/' : Astro.url.pathname, Astro.site);
const og = await getImage({ src: photo, width: 1200, format: 'jpg' });
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: person.name,
  jobTitle: person.role,
  url: Astro.site?.href,
  email: `mailto:${person.email}`,
  sameAs: [person.linkedin, person.github],
  address: { '@type': 'PostalAddress', addressLocality: 'Nettetal', addressCountry: 'DE' },
  hasCredential: certifications.map((c) => ({ '@type': 'EducationalOccupationalCredential', name: c.name })),
};
---
<!doctype html>
<html lang="de" data-design={design}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="profile" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(og.src, Astro.site)} />
    <meta property="og:locale" content="de_DE" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip" href="#main">Zum Inhalt springen</a>
    <slot />
    {isAlt && (
      <nav class="switcher" aria-label="Design wählen">
        <span>Design</span>
        {designs.map((d) => (
          <a href={designUrl(d.slug)} aria-current={d.slug === design ? 'page' : undefined}>{d.name}</a>
        ))}
      </nav>
    )}
  </body>
</html>

<style is:global>
  *, *::before, *::after { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }
  body { margin: 0; }
  img { max-width: 100%; height: auto; display: block; }
  /* German compounds ("Krisenvorsorgeinformationssystem") overflow narrow screens otherwise */
  h1, h2, h3, p, dd, li { overflow-wrap: break-word; hyphens: auto; }
  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    *, *::before, *::after { animation: none !important; transition: none !important; }
  }
  .skip {
    position: absolute; left: 1rem; top: -4rem; z-index: 100;
    background: #000; color: #fff; padding: .6rem 1rem; border-radius: .4rem;
  }
  .skip:focus { top: 1rem; }
  .switcher {
    position: fixed; right: 1rem; bottom: 1rem; z-index: 50;
    display: flex; align-items: center; gap: .25rem;
    padding: .35rem .4rem .35rem .8rem; border-radius: 999px;
    background: rgb(20 20 24 / .9); color: #fff; backdrop-filter: blur(8px);
    font: 500 .8rem/1 system-ui, sans-serif; box-shadow: 0 6px 24px rgb(0 0 0 / .25);
  }
  .switcher span { margin-right: .3rem; opacity: .7; }
  .switcher { flex-wrap: wrap; justify-content: flex-end; max-width: calc(100vw - 2rem); border-radius: 1.2rem; }
  nav.switcher a {
    display: grid; place-items: center; height: 2rem; padding: 0 .7rem; border-radius: 999px;
    color: #fff; text-decoration: none;
  }
  .switcher a:hover { background: rgb(255 255 255 / .15); }
  .switcher a[aria-current] { background: #fff; color: #000; }
</style>
